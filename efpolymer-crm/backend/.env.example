# Database
DATABASE_URL="file:./data/efpcrm.db"

# Security
JWT_SECRET="efpolymer-crm-jwt-secret-key-change-in-production"
SESSION_SECRET="efpolymer-crm-session-secret-change-in-production"

# Server
PORT=8443
HOST=127.0.0.1

# Features
LAN_MODE=false
TELEMETRY_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"

# Localization
DEFAULT_LOCALE=en

# Performance
MAX_UPLOAD_SIZE=52428800
QUERY_TIMEOUT=5000

# Session
SESSION_TIMEOUT_MINUTES=20